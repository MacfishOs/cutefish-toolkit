defines = -DSKSHAPER_IMPLEMENTATION=1 -DNDEBUG -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSK_SHAPER_PRIMITIVE_AVAILABLE -DSK_SHAPER_HARFBUZZ_AVAILABLE -DSK_SHAPER_UNICODE_AVAILABLE -DSK_CODEC_DECODES_ICO -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_PNG_WITH_LIBPNG -DSK_CODEC_ENCODES_PNG -DSK_CODEC_ENCODES_PNG_WITH_LIBPNG -DSK_TYPEFACE_FACTORY_FREETYPE -DSK_FONTMGR_FCI_AVAILABLE -DSK_FONTMGR_ANDROID_AVAILABLE -DSK_FONTMGR_FONTCONFIG_AVAILABLE -DSK_GL -DSK_CODEC_ENCODES_JPEG -DSK_CODEC_DECODES_JPEG -DSK_XML -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_UNICODE_AVAILABLE -DSK_UNICODE_ICU_IMPLEMENTATION
framework_dirs =
include_dirs = -I../../third_party/skia/modules/skshaper/include -I../../third_party/skia -I/usr/include/harfbuzz
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = libskshaper

build obj/modules/skshaper/src/libskshaper.SkShaper.o: cxx ../../third_party/skia/modules/skshaper/src/SkShaper.cpp
  source_file_part = SkShaper.cpp
  source_name_part = SkShaper
build obj/modules/skshaper/src/libskshaper.SkShaper_factory.o: cxx ../../third_party/skia/modules/skshaper/src/SkShaper_factory.cpp
  source_file_part = SkShaper_factory.cpp
  source_name_part = SkShaper_factory
build obj/modules/skshaper/src/libskshaper.SkShaper_primitive.o: cxx ../../third_party/skia/modules/skshaper/src/SkShaper_primitive.cpp
  source_file_part = SkShaper_primitive.cpp
  source_name_part = SkShaper_primitive
build obj/modules/skshaper/src/libskshaper.SkShaper_skunicode.o: cxx ../../third_party/skia/modules/skshaper/src/SkShaper_skunicode.cpp
  source_file_part = SkShaper_skunicode.cpp
  source_name_part = SkShaper_skunicode
build obj/modules/skshaper/src/libskshaper.SkShaper_harfbuzz.o: cxx ../../third_party/skia/modules/skshaper/src/SkShaper_harfbuzz.cpp
  source_file_part = SkShaper_harfbuzz.cpp
  source_name_part = SkShaper_harfbuzz

build ./libskshaper.a: alink obj/modules/skshaper/src/libskshaper.SkShaper.o obj/modules/skshaper/src/libskshaper.SkShaper_factory.o obj/modules/skshaper/src/libskshaper.SkShaper_primitive.o obj/modules/skshaper/src/libskshaper.SkShaper_skunicode.o obj/modules/skshaper/src/libskshaper.SkShaper_harfbuzz.o || ./libskia.a obj/modules/skunicode/skunicode.stamp obj/third_party/harfbuzz/harfbuzz.stamp obj/src/partition_alloc/raw_ptr.stamp ./libskunicode_core.a ./libskunicode_icu.a
  arflags =
  output_extension = .a
  output_dir = 
