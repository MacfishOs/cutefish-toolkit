  source_file_part = ParagraphImpl.cpp
  source_name_part = ParagraphImpl
build obj/modules/skparagraph/src/libskparagraph.ParagraphPainterImpl.o: cxx ../../third_party/skia/modules/skparagraph/src/ParagraphPainterImpl.cpp
  source_file_part = ParagraphPainterImpl.cpp
  source_name_part = ParagraphPainterImpl
build obj/modules/skparagraph/src/libskparagraph.ParagraphStyle.o: cxx ../../third_party/skia/modules/skparagraph/src/ParagraphStyle.cpp
  source_file_part = ParagraphStyle.cpp
  source_name_part = ParagraphStyle
build obj/modules/skparagraph/src/libskparagraph.Run.o: cxx ../../third_party/skia/modules/skparagraph/src/Run.cpp
