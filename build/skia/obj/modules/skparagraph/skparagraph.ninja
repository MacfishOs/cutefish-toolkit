defines = -DNDEBUG -DSK_ENABLE_PARAGRAPH -DSK_CODEC_DECODES_ICO -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_PNG_WITH_LIBPNG -DSK_CODEC_ENCODES_PNG -DSK_CODEC_ENCODES_PNG_WITH_LIBPNG -DSK_TYPEFACE_FACTORY_FREETYPE -DSK_FONTMGR_FCI_AVAILABLE -DSK_FONTMGR_ANDROID_AVAILABLE -DSK_FONTMGR_FONTCONFIG_AVAILABLE -DSK_GL -DSK_CODEC_ENCODES_JPEG -DSK_CODEC_DECODES_JPEG -DSK_XML -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_UNICODE_AVAILABLE -DSK_UNICODE_ICU_IMPLEMENTATION -DSK_SHAPER_PRIMITIVE_AVAILABLE -DSK_SHAPER_HARFBUZZ_AVAILABLE -DSK_SHAPER_UNICODE_AVAILABLE
framework_dirs =
include_dirs = -I../../third_party/skia/modules/skparagraph/include -I../../third_party/skia/modules/skparagraph/utils -I../../third_party/skia -I../../third_party/skia/modules/skshaper/include
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = libskparagraph

build obj/modules/skparagraph/src/libskparagraph.Decorations.o: cxx ../../third_party/skia/modules/skparagraph/src/Decorations.cpp
  source_file_part = Decorations.cpp
  source_name_part = Decorations
build obj/modules/skparagraph/src/libskparagraph.FontArguments.o: cxx ../../third_party/skia/modules/skparagraph/src/FontArguments.cpp
  source_file_part = FontArguments.cpp
  source_name_part = FontArguments
build obj/modules/skparagraph/src/libskparagraph.FontCollection.o: cxx ../../third_party/skia/modules/skparagraph/src/FontCollection.cpp
