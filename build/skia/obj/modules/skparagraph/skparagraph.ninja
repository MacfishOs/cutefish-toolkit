build obj/modules/skparagraph/src/libskparagraph.TextStyle.o: cxx ../../third_party/skia/modules/skparagraph/src/TextStyle.cpp
  source_file_part = TextStyle.cpp
  source_name_part = TextStyle
build obj/modules/skparagraph/src/libskparagraph.TextWrapper.o: cxx ../../third_party/skia/modules/skparagraph/src/TextWrapper.cpp
  source_file_part = TextWrapper.cpp
  source_name_part = TextWrapper
build obj/modules/skparagraph/src/libskparagraph.TypefaceFontProvider.o: cxx ../../third_party/skia/modules/skparagraph/src/TypefaceFontProvider.cpp
