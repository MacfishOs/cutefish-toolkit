build ./libskparagraph.a: alink obj/modules/skparagraph/src/libskparagraph.Decorations.o obj/modules/skparagraph/src/libskparagraph.FontArguments.o obj/modules/skparagraph/src/libskparagraph.FontCollection.o obj/modules/skparagraph/src/libskparagraph.OneLineShaper.o obj/modules/skparagraph/src/libskparagraph.ParagraphBuilderImpl.o obj/modules/skparagraph/src/libskparagraph.ParagraphCache.o obj/modules/skparagraph/src/libskparagraph.ParagraphImpl.o obj/modules/skparagraph/src/libskparagraph.ParagraphPainterImpl.o obj/modules/skparagraph/src/libskparagraph.ParagraphStyle.o obj/modules/skparagraph/src/libskparagraph.Run.o obj/modules/skparagraph/src/libskparagraph.TextLine.o obj/modules/skparagraph/src/libskparagraph.TextShadow.o obj/modules/skparagraph/src/libskparagraph.TextStyle.o obj/modules/skparagraph/src/libskparagraph.TextWrapper.o obj/modules/skparagraph/src/libskparagraph.TypefaceFontProvider.o || ./libskia.a obj/modules/skunicode/skunicode.stamp ./libskshaper.a obj/src/partition_alloc/raw_ptr.stamp ./libskunicode_core.a ./libskunicode_icu.a
