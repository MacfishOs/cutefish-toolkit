defines = -DNDEBUG
framework_dirs =
include_dirs =
cflags = -mavx2 -mf16c -std=c11 -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = skcms_TransformHsw

build obj/modules/skcms/src/skcms_TransformHsw.skcms_TransformHsw.o: cxx ../../third_party/skia/modules/skcms/src/skcms_TransformHsw.cc
  source_file_part = skcms_TransformHsw.cc
  source_name_part = skcms_TransformHsw

build obj/modules/skcms/skcms_TransformHsw.stamp: stamp obj/modules/skcms/src/skcms_TransformHsw.skcms_TransformHsw.o
