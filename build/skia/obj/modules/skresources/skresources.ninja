defines = -DNDEBUG -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_CODEC_DECODES_ICO -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_PNG_WITH_LIBPNG -DSK_CODEC_ENCODES_PNG -DSK_CODEC_ENCODES_PNG_WITH_LIBPNG -DSK_TYPEFACE_FACTORY_FREETYPE -DSK_FONTMGR_FCI_AVAILABLE -DSK_FONTMGR_ANDROID_AVAILABLE -DSK_FONTMGR_FONTCONFIG_AVAILABLE -DSK_GL -DSK_CODEC_ENCODES_JPEG -DSK_CODEC_DECODES_JPEG -DSK_XML -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING
framework_dirs =
include_dirs = -I../../third_party/skia/modules/skresources/include -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = libskresources

build obj/modules/skresources/src/libskresources.SkAnimCodecPlayer.o: cxx ../../third_party/skia/modules/skresources/src/SkAnimCodecPlayer.cpp
  source_file_part = SkAnimCodecPlayer.cpp
  source_name_part = SkAnimCodecPlayer
build obj/modules/skresources/src/libskresources.SkResources.o: cxx ../../third_party/skia/modules/skresources/src/SkResources.cpp
  source_file_part = SkResources.cpp
  source_name_part = SkResources

build ./libskresources.a: alink obj/modules/skresources/src/libskresources.SkAnimCodecPlayer.o obj/modules/skresources/src/libskresources.SkResources.o || ./libskia.a obj/experimental/ffmpeg/video_decoder.stamp
  arflags =
  output_extension = .a
  output_dir = 
