defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_TYPEFACE_FACTORY_FREETYPE
framework_dirs =
include_dirs = -I../../third_party/skia -I/usr/include/freetype2
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = typeface_freetype

build obj/src/ports/typeface_freetype.SkFontHost_FreeType.o: cxx ../../third_party/skia/src/ports/SkFontHost_FreeType.cpp
  source_file_part = SkFontHost_FreeType.cpp
  source_name_part = SkFontHost_FreeType
build obj/src/ports/typeface_freetype.SkFontHost_FreeType_common.o: cxx ../../third_party/skia/src/ports/SkFontHost_FreeType_common.cpp
  source_file_part = SkFontHost_FreeType_common.cpp
  source_name_part = SkFontHost_FreeType_common

build obj/typeface_freetype.stamp: stamp obj/src/ports/typeface_freetype.SkFontHost_FreeType.o obj/src/ports/typeface_freetype.SkFontHost_FreeType_common.o || obj/third_party/freetype2/freetype2.stamp obj/src/partition_alloc/raw_ptr.stamp
