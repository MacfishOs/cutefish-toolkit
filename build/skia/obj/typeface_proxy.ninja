defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = typeface_proxy

build obj/src/ports/typeface_proxy.SkTypeface_proxy.o: cxx ../../third_party/skia/src/ports/SkTypeface_proxy.cpp
  source_file_part = SkTypeface_proxy.cpp
  source_name_part = SkTypeface_proxy

build obj/typeface_proxy.stamp: stamp obj/src/ports/typeface_proxy.SkTypeface_proxy.o || obj/src/partition_alloc/raw_ptr.stamp
