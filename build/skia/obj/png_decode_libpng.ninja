defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_CODEC_DECODES_ICO -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_PNG_WITH_LIBPNG
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = png_decode_libpng

build obj/src/codec/png_decode_libpng.SkIcoCodec.o: cxx ../../third_party/skia/src/codec/SkIcoCodec.cpp
  source_file_part = SkIcoCodec.cpp
  source_name_part = SkIcoCodec
build obj/src/codec/png_decode_libpng.SkPngCodec.o: cxx ../../third_party/skia/src/codec/SkPngCodec.cpp
  source_file_part = SkPngCodec.cpp
  source_name_part = SkPngCodec

build obj/png_decode_libpng.stamp: stamp obj/src/codec/png_decode_libpng.SkIcoCodec.o obj/src/codec/png_decode_libpng.SkPngCodec.o || obj/png_decode_common.stamp obj/third_party/libpng/libpng.stamp obj/src/partition_alloc/raw_ptr.stamp
