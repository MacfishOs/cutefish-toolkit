defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_XML -DSK_CODEC_DECODES_ICO -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_PNG_WITH_LIBPNG -DSK_CODEC_ENCODES_PNG -DSK_CODEC_ENCODES_PNG_WITH_LIBPNG -DSK_TYPEFACE_FACTORY_FREETYPE
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = xml

build obj/src/xml/xml.SkDOM.o: cxx ../../third_party/skia/src/xml/SkDOM.cpp
  source_file_part = SkDOM.cpp
  source_name_part = SkDOM
build obj/src/xml/xml.SkXMLParser.o: cxx ../../third_party/skia/src/xml/SkXMLParser.cpp
  source_file_part = SkXMLParser.cpp
  source_name_part = SkXMLParser
build obj/src/xml/xml.SkXMLWriter.o: cxx ../../third_party/skia/src/xml/SkXMLWriter.cpp
  source_file_part = SkXMLWriter.cpp
  source_name_part = SkXMLWriter
build obj/src/codec/xml.SkXmp.o: cxx ../../third_party/skia/src/codec/SkXmp.cpp
  source_file_part = SkXmp.cpp
  source_name_part = SkXmp
build obj/src/svg/xml.SkSVGCanvas.o: cxx ../../third_party/skia/src/svg/SkSVGCanvas.cpp
  source_file_part = SkSVGCanvas.cpp
  source_name_part = SkSVGCanvas
build obj/src/svg/xml.SkSVGDevice.o: cxx ../../third_party/skia/src/svg/SkSVGDevice.cpp
  source_file_part = SkSVGDevice.cpp
  source_name_part = SkSVGDevice

build obj/xml.stamp: stamp obj/src/xml/xml.SkDOM.o obj/src/xml/xml.SkXMLParser.o obj/src/xml/xml.SkXMLWriter.o obj/src/codec/xml.SkXmp.o obj/src/svg/xml.SkSVGCanvas.o obj/src/svg/xml.SkSVGDevice.o || obj/core.stamp obj/third_party/expat/expat.stamp obj/png_encode_libpng.stamp obj/src/partition_alloc/raw_ptr.stamp obj/fontmgr_mac_ct.stamp obj/fontmgr_win.stamp obj/fontmgr_win_gdi.stamp obj/png_decode_libpng.stamp obj/png_decode_common.stamp obj/png_encode_common.stamp obj/typeface_fontations.stamp obj/typeface_freetype.stamp
