defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_FONTMGR_FCI_AVAILABLE
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = fontmgr_FontConfigInterface

build obj/src/ports/fontmgr_FontConfigInterface.SkFontConfigInterface.o: cxx ../../third_party/skia/src/ports/SkFontConfigInterface.cpp
  source_file_part = SkFontConfigInterface.cpp
  source_name_part = SkFontConfigInterface
build obj/src/ports/fontmgr_FontConfigInterface.SkFontConfigInterface_direct.o: cxx ../../third_party/skia/src/ports/SkFontConfigInterface_direct.cpp
  source_file_part = SkFontConfigInterface_direct.cpp
  source_name_part = SkFontConfigInterface_direct
build obj/src/ports/fontmgr_FontConfigInterface.SkFontConfigInterface_direct_factory.o: cxx ../../third_party/skia/src/ports/SkFontConfigInterface_direct_factory.cpp
  source_file_part = SkFontConfigInterface_direct_factory.cpp
  source_name_part = SkFontConfigInterface_direct_factory
build obj/src/ports/fontmgr_FontConfigInterface.SkFontMgr_FontConfigInterface.o: cxx ../../third_party/skia/src/ports/SkFontMgr_FontConfigInterface.cpp
  source_file_part = SkFontMgr_FontConfigInterface.cpp
  source_name_part = SkFontMgr_FontConfigInterface

build obj/fontmgr_FontConfigInterface.stamp: stamp obj/src/ports/fontmgr_FontConfigInterface.SkFontConfigInterface.o obj/src/ports/fontmgr_FontConfigInterface.SkFontConfigInterface_direct.o obj/src/ports/fontmgr_FontConfigInterface.SkFontConfigInterface_direct_factory.o obj/src/ports/fontmgr_FontConfigInterface.SkFontMgr_FontConfigInterface.o || obj/third_party/fontconfig.stamp obj/src/partition_alloc/raw_ptr.stamp
