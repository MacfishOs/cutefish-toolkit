defines = -DNDEBUG -DSK_USE_INTERNAL_VULKAN_HEADERS -DSK_CODEC_DECODES_ICO -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_PNG_WITH_LIBPNG -DSK_CODEC_ENCODES_PNG -DSK_CODEC_ENCODES_PNG_WITH_LIBPNG -DSK_TYPEFACE_FACTORY_FREETYPE -DSK_FONTMGR_FCI_AVAILABLE -DSK_FONTMGR_ANDROID_AVAILABLE -DSK_FONTMGR_FONTCONFIG_AVAILABLE -DSK_GL -DSK_CODEC_ENCODES_JPEG -DSK_CODEC_DECODES_JPEG -DSK_XML -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_SHAPER_PRIMITIVE_AVAILABLE -DSK_SHAPER_HARFBUZZ_AVAILABLE -DSK_SHAPER_UNICODE_AVAILABLE
framework_dirs =
include_dirs = -I../../third_party/skia/include/third_party/vulkan -I../../third_party/skia -Igen -I../../third_party/skia/modules/skshaper/include
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = public_headers_warnings_check

build obj/tools/public_headers_warnings_check.public_headers_warnings_check.o: cxx ../../third_party/skia/tools/public_headers_warnings_check.cpp || obj/skia.h.stamp
  source_file_part = public_headers_warnings_check.cpp
  source_name_part = public_headers_warnings_check

build obj/public_headers_warnings_check.stamp: stamp obj/tools/public_headers_warnings_check.public_headers_warnings_check.o || ./libskia.a obj/skia.h.stamp obj/modules/skottie/skottie.stamp ./libskshaper.a obj/src/partition_alloc/raw_ptr.stamp ./libskunicode_core.a ./libskunicode_icu.a
