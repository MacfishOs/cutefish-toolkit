defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_CODEC_ENCODES_JPEG -DSK_CODEC_DECODES_ICO -DSK_CODEC_DECODES_PNG -DSK_CODEC_DECODES_PNG_WITH_LIBPNG -DSK_CODEC_ENCODES_PNG -DSK_CODEC_ENCODES_PNG_WITH_LIBPNG -DSK_TYPEFACE_FACTORY_FREETYPE
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = jpeg_encode

build obj/src/encode/jpeg_encode.SkJPEGWriteUtility.o: cxx ../../third_party/skia/src/encode/SkJPEGWriteUtility.cpp
  source_file_part = SkJPEGWriteUtility.cpp
  source_name_part = SkJPEGWriteUtility
build obj/src/encode/jpeg_encode.SkJpegEncoderImpl.o: cxx ../../third_party/skia/src/encode/SkJpegEncoderImpl.cpp
  source_file_part = SkJpegEncoderImpl.cpp
  source_name_part = SkJpegEncoderImpl

build obj/jpeg_encode.stamp: stamp obj/src/encode/jpeg_encode.SkJPEGWriteUtility.o obj/src/encode/jpeg_encode.SkJpegEncoderImpl.o || obj/core.stamp obj/third_party/libjpeg-turbo/libjpeg.stamp obj/src/partition_alloc/raw_ptr.stamp obj/fontmgr_mac_ct.stamp obj/fontmgr_win.stamp obj/fontmgr_win_gdi.stamp obj/png_decode_libpng.stamp obj/png_decode_common.stamp obj/png_encode_libpng.stamp obj/png_encode_common.stamp obj/typeface_fontations.stamp obj/typeface_freetype.stamp
