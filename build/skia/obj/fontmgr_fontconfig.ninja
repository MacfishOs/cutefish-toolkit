defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_FONTMGR_FONTCONFIG_AVAILABLE
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = fontmgr_fontconfig

build obj/src/ports/fontmgr_fontconfig.SkFontMgr_fontconfig.o: cxx ../../third_party/skia/src/ports/SkFontMgr_fontconfig.cpp
  source_file_part = SkFontMgr_fontconfig.cpp
  source_name_part = SkFontMgr_fontconfig

build obj/fontmgr_fontconfig.stamp: stamp obj/src/ports/fontmgr_fontconfig.SkFontMgr_fontconfig.o || obj/third_party/fontconfig.stamp obj/typeface_proxy.stamp obj/src/partition_alloc/raw_ptr.stamp
