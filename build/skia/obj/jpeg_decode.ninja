defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1 -DSK_CODEC_DECODES_JPEG
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = jpeg_decode

build obj/src/codec/jpeg_decode.SkJpegCodec.o: cxx ../../third_party/skia/src/codec/SkJpegCodec.cpp
  source_file_part = SkJpegCodec.cpp
  source_name_part = SkJpegCodec
build obj/src/codec/jpeg_decode.SkJpegDecoderMgr.o: cxx ../../third_party/skia/src/codec/SkJpegDecoderMgr.cpp
  source_file_part = SkJpegDecoderMgr.cpp
  source_name_part = SkJpegDecoderMgr
build obj/src/codec/jpeg_decode.SkJpegMetadataDecoderImpl.o: cxx ../../third_party/skia/src/codec/SkJpegMetadataDecoderImpl.cpp
  source_file_part = SkJpegMetadataDecoderImpl.cpp
  source_name_part = SkJpegMetadataDecoderImpl
build obj/src/codec/jpeg_decode.SkJpegSourceMgr.o: cxx ../../third_party/skia/src/codec/SkJpegSourceMgr.cpp
  source_file_part = SkJpegSourceMgr.cpp
  source_name_part = SkJpegSourceMgr
build obj/src/codec/jpeg_decode.SkJpegUtility.o: cxx ../../third_party/skia/src/codec/SkJpegUtility.cpp
  source_file_part = SkJpegUtility.cpp
  source_name_part = SkJpegUtility

build obj/jpeg_decode.stamp: stamp obj/src/codec/jpeg_decode.SkJpegCodec.o obj/src/codec/jpeg_decode.SkJpegDecoderMgr.o obj/src/codec/jpeg_decode.SkJpegMetadataDecoderImpl.o obj/src/codec/jpeg_decode.SkJpegSourceMgr.o obj/src/codec/jpeg_decode.SkJpegUtility.o || obj/third_party/libjpeg-turbo/libjpeg.stamp obj/src/partition_alloc/raw_ptr.stamp
