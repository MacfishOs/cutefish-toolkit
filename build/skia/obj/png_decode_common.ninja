defines = -DNDEBUG -DSK_CODEC_DECODES_BMP -DSK_CODEC_DECODES_WBMP -DSK_R32_SHIFT=16 -DSK_ENABLE_PRECOMPILE -DSK_GANESH -DSK_DISABLE_TRACING -DSK_GAMMA_APPLY_TO_A8 -DSK_ENABLE_AVX512_OPTS -DSKIA_IMPLEMENTATION=1
framework_dirs =
include_dirs = -I../../third_party/skia
cflags = -Wno-attributes -ffp-contract=off -fPIC -fvisibility=hidden -fstrict-aliasing -O3 -fdata-sections -ffunction-sections -Wno-psabi
cflags_cc = -fvisibility-inlines-hidden -std=c++20 -fno-exceptions -fno-rtti -frtti
root_out_dir = .
target_output_name = png_decode_common

build obj/src/codec/png_decode_common.SkPngCodecBase.o: cxx ../../third_party/skia/src/codec/SkPngCodecBase.cpp
  source_file_part = SkPngCodecBase.cpp
  source_name_part = SkPngCodecBase
build obj/src/codec/png_decode_common.SkPngCompositeChunkReader.o: cxx ../../third_party/skia/src/codec/SkPngCompositeChunkReader.cpp
  source_file_part = SkPngCompositeChunkReader.cpp
  source_name_part = SkPngCompositeChunkReader

build obj/png_decode_common.stamp: stamp obj/src/codec/png_decode_common.SkPngCodecBase.o obj/src/codec/png_decode_common.SkPngCompositeChunkReader.o || obj/src/partition_alloc/raw_ptr.stamp
