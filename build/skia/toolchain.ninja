rule objc
  command =  /usr/bin/clang -MD -MF ${out}.d ${defines} ${include_dirs} ${framework_dirs} ${cflags} ${cflags_objc} -c ${in} -o ${out}
  description = compile ${in}
  depfile = ${out}.d
  deps = gcc
rule link
  command = /usr/bin/clang++ ${ldflags} -Wl,--start-group @${root_out_dir}/${target_output_name}${output_extension}.rsp ${frameworks} ${solibs} -Wl,--end-group ${libs} -o ${root_out_dir}/${target_output_name}${output_extension}
  description = link ${out}
  rspfile = ${root_out_dir}/${target_output_name}${output_extension}.rsp
  rspfile_content = ${in}
rule compile_xcassets
  command = true
  description = compile_xcassets ${out}
rule cxx
  command =  /usr/bin/clang++ -MD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_cc} -c ${in} -o ${out}
  description = compile ${in}
  depfile = ${out}.d
  deps = gcc
rule solink
  command = /usr/bin/clang++ -shared ${ldflags} -Wl,--start-group @${out}.rsp ${frameworks} ${solibs} -Wl,--end-group ${libs} -Wl,-soname,${target_output_name}${output_extension}  -o ${out}
  description = link ${out}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule stamp
  command = touch ${out}
  description = stamp ${out}
rule copy_bundle_data
  command = python3 "/home/jatin/Documents/development/cutefish-new/cutefish-toolkit/third_party/skia/gn/cp.py" ${in} ${out}
  description = copy_bundle_data ${in} ${out}
rule objcxx
  command =  /usr/bin/clang++ -MD -MF ${out}.d ${defines} ${include_dirs} ${framework_dirs} ${cflags} ${cflags_objcc} -c ${in} -o ${out}
  description = compile ${in}
  depfile = ${out}.d
  deps = gcc
rule alink
  command =  python3 "/home/jatin/Documents/development/cutefish-new/cutefish-toolkit/third_party/skia/gn/rm.py" "${out}" && ar rcs ${out} @${out}.rsp
  description = link ${out}
  rspfile = ${out}.rsp
  rspfile_content = ${in}
rule cc
  command =  /usr/bin/clang -MD -MF ${out}.d ${defines} ${include_dirs} ${cflags} ${cflags_c} -c ${in} -o ${out}
  description = compile ${in}
  depfile = ${out}.d
  deps = gcc
rule asm
  command =  /usr/bin/clang -MD -MF ${out}.d ${defines} ${include_dirs} ${asmflags} -c ${in} -o ${out}
  description = assemble ${in}
  depfile = ${out}.d
  deps = gcc
rule copy
  command = python3 "/home/jatin/Documents/development/cutefish-new/cutefish-toolkit/third_party/skia/gn/cp.py" ${in} ${out}
  description = copy ${in} ${out}

